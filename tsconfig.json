{
  "compilerOptions": {
    // Base config is also the type-check config (src + test). The test suite
    // imports extensionlessly, so resolution here must tolerate that; each
    // build config overrides module/moduleResolution for its own emit format.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", "test/**/*", "global.d.ts"]
}
